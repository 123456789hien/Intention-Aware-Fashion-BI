# Copy file này thành .streamlit/secrets.toml (local dev) — file đó đã bị
# .gitignore loại trừ, sẽ không bao giờ lên GitHub.
#
# Khi deploy lên Streamlit Community Cloud, KHÔNG dùng file này — dán trực
# tiếp nội dung dưới đây vào mục "Secrets" trong Settings của app trên
# https://share.streamlit.io (xem README.md, phần "Deploy lên Streamlit").

GDRIVE_FILE_ID = "PASTE_YOUR_GOOGLE_DRIVE_FILE_ID_HERE"
